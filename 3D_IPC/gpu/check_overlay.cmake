# Generate/check the actual canonical sources without CUDA or compilation.
# Usage: cmake -DIPC_OVERLAY_OUTPUT_DIR=/absolute/fresh/owned-dir
#              [-DIPC_CPU_SOURCE=/absolute/compatible/cpu-source]
#              [-DIPC_OVERLAY_EXPECTED_RESIDENT_SHA256=<canonical SHA>]
#              -P gpu/check_overlay.cmake
# Expected-failure anchor tests: IPC_OVERLAY_NEGATIVE_CASE=MISSING_ANCHOR or
# DUPLICATE_ANCHOR. These fail before creating any output directory.
cmake_minimum_required(VERSION 3.24)
get_filename_component(CMAKE_CURRENT_SOURCE_DIR "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)
if(NOT DEFINED IPC_CPU_SOURCE)
    set(IPC_CPU_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/..")
endif()
get_filename_component(IPC_CPU_SOURCE "${IPC_CPU_SOURCE}" ABSOLUTE)
include("${CMAKE_CURRENT_SOURCE_DIR}/cmake/GeneratedSources.cmake")

if(DEFINED IPC_OVERLAY_NEGATIVE_CASE)
    if(IPC_OVERLAY_NEGATIVE_CASE STREQUAL "MISSING_ANCHOR")
        set(sample "one anchor")
        replace_once(sample "missing" "replacement")
    elseif(IPC_OVERLAY_NEGATIVE_CASE STREQUAL "DUPLICATE_ANCHOR")
        set(sample "anchor anchor")
        replace_once(sample "anchor" "replacement")
    else()
        message(FATAL_ERROR "Unknown negative anchor check")
    endif()
    message(FATAL_ERROR "Negative anchor check unexpectedly returned")
endif()

if(NOT DEFINED IPC_OVERLAY_OUTPUT_DIR)
    set(IPC_OVERLAY_OUTPUT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/build-overlay-check")
endif()
if(NOT IS_ABSOLUTE "${IPC_OVERLAY_OUTPUT_DIR}")
    message(FATAL_ERROR "Overlay output must be an absolute owned directory")
endif()
get_filename_component(normalized_output "${IPC_OVERLAY_OUTPUT_DIR}" ABSOLUTE)
if(NOT normalized_output STREQUAL IPC_OVERLAY_OUTPUT_DIR
   OR normalized_output STREQUAL CMAKE_CURRENT_SOURCE_DIR
   OR normalized_output STREQUAL IPC_CPU_SOURCE)
    message(FATAL_ERROR "Unsafe overlay output directory")
endif()
set(parent_check "${normalized_output}")
while(TRUE)
    if(IS_SYMLINK "${parent_check}")
        message(FATAL_ERROR "Overlay output parent is redirected")
    endif()
    get_filename_component(next_parent "${parent_check}" DIRECTORY)
    if(next_parent STREQUAL parent_check)
        break()
    endif()
    set(parent_check "${next_parent}")
endwhile()
if(EXISTS "${normalized_output}" AND NOT IS_DIRECTORY "${normalized_output}")
    message(FATAL_ERROR "Overlay output is not a directory")
endif()
set(marker "${normalized_output}/IPC_GPU_OVERLAY_CHECK_ONLY.txt")
set(marker_contents "IPC GPU checked overlay outputs only\n")
set(generated_names solver_gpu.cpp simulation_gpu.cpp simulation_resident.cpp)
set(allowed_names ${generated_names} IPC_GPU_OVERLAY_CHECK_ONLY.txt)
file(GLOB existing_entries "${normalized_output}/*")
if(existing_entries AND NOT EXISTS "${marker}")
    message(FATAL_ERROR "Refuse to overwrite an unowned nonempty output directory")
endif()
if(EXISTS "${marker}")
    if(IS_SYMLINK "${marker}" OR IS_DIRECTORY "${marker}")
        message(FATAL_ERROR "Overlay output ownership marker is not a regular file")
    endif()
    file(READ "${marker}" previous_marker)
    if(NOT previous_marker STREQUAL marker_contents)
        message(FATAL_ERROR "Overlay output ownership marker differs")
    endif()
endif()
foreach(entry IN LISTS existing_entries)
    get_filename_component(name "${entry}" NAME)
    if(NOT name IN_LIST allowed_names OR IS_SYMLINK "${entry}" OR IS_DIRECTORY "${entry}")
        message(FATAL_ERROR "Unknown/nonregular file in overlay output directory")
    endif()
endforeach()
set(CMAKE_CURRENT_BINARY_DIR "${normalized_output}")
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
ipc_gpu_write_generated_if_different("${marker}" "${marker_contents}")

# Both CMake targets and this checker call these exact same generator functions.
ipc_gpu_generate_hybrid_sources()
ipc_gpu_generate_resident_driver()
file(READ "${CMAKE_CURRENT_BINARY_DIR}/simulation_resident.cpp" resident_driver)
if(resident_driver MATCHES "advance_one_frame(_general|_rb)?[ \t\r\n]*\\(")
    message(FATAL_ERROR "Resident driver still contains a CPU frame dispatch")
endif()

set(expected_variables IPC_OVERLAY_EXPECTED_SOLVER_SHA256
    IPC_OVERLAY_EXPECTED_HYBRID_DRIVER_SHA256 IPC_OVERLAY_EXPECTED_RESIDENT_SHA256)
foreach(index RANGE 0 2)
    list(GET generated_names ${index} name)
    list(GET expected_variables ${index} expected_variable)
    set(path "${CMAKE_CURRENT_BINARY_DIR}/${name}")
    file(SHA256 "${path}" hash_${index})
    file(TIMESTAMP "${path}" stamp_${index} "%s.%f" UTC)
    if(DEFINED ${expected_variable})
        string(LENGTH "${${expected_variable}}" expected_length)
        if(NOT expected_length EQUAL 64 OR NOT "${${expected_variable}}" MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "Expected generated-source SHA must be 64 lowercase hex digits")
        endif()
        if(NOT "${hash_${index}}" STREQUAL "${${expected_variable}}")
            message(FATAL_ERROR "Generated source differs from expected canonical bytes: ${name}")
        endif()
    endif()
endforeach()
ipc_gpu_generate_hybrid_sources()
ipc_gpu_generate_resident_driver()
foreach(index RANGE 0 2)
    list(GET generated_names ${index} name)
    set(path "${CMAKE_CURRENT_BINARY_DIR}/${name}")
    file(SHA256 "${path}" repeated_hash)
    file(TIMESTAMP "${path}" repeated_stamp "%s.%f" UTC)
    if(NOT repeated_hash STREQUAL "${hash_${index}}" OR NOT repeated_stamp STREQUAL "${stamp_${index}}")
        message(FATAL_ERROR "No-change generation rewrote source bytes or timestamps: ${name}")
    endif()
    message(STATUS "Checked canonical generated source: ${path}")
endforeach()
